        <mxCell id="indices" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#EAF6FD;strokeColor=#2D93D0;" value="&lt;p style=&quot;margin:0;padding:4px;text-align:center;background:#23A2D9;color:#fff&quot;&gt;&lt;b&gt;Índices (Flyway V1)&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;padding:4px 6px;font-family:monospace&quot;&gt;kudo (fecha DESC, id DESC)  &lt;i&gt;feed por keyset&lt;/i&gt;&lt;br&gt;kudo (autor_id) · kudo (destinatario_id)&lt;br&gt;kudo (categoria_id)&lt;br&gt;adjunto (kudo_id)&lt;br&gt;outbox_evento (creado_en)&lt;br&gt;  WHERE enviado_en IS NULL  &lt;i&gt;relevo&lt;/i&gt;&lt;/p&gt;" vertex="1">

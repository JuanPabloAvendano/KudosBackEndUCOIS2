          <mxGeometry height="135" width="260" x="990" y="780" as="geometry" />
        </mxCell>
        <mxCell id="ley" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11" value="&lt;b&gt;Leyenda:&lt;/b&gt; amarillo = dominio (núcleo) · verde = servicios (casos de uso y puertos) · azul = infraestructura (adaptadores) · gris = raíz y transversal · - - -&amp;gt; dependencia: el origen usa al destino · nombre en la pestaña y miembros dentro (UML 2.5.1, §12.2.4) · nombres relativos al paquete contenedor; nombre completo en la tabla de diseno-detallado.md §2" vertex="1">

        <mxCell id="kudo" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#EAF6FD;strokeColor=#2D93D0;" value="&lt;p style=&quot;margin:0;padding:4px;text-align:center&quot;&gt;&lt;i&gt;«raíz de agregado»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Kudo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px&quot;&gt;- id: KudoId&lt;br&gt;- autor: UsuarioId&lt;br&gt;- destinatario: UsuarioId&lt;br&gt;- categoria: CategoriaId&lt;br&gt;- contenido: String&lt;br&gt;- fecha: Instant&lt;br&gt;- adjuntos: List&amp;lt;Adjunto&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 6px&quot;&gt;+ publicar(autor: UsuarioId, destinatario: UsuarioId,&lt;br&gt;    categoria: CategoriaId, contenido: String,&lt;br&gt;    adjuntos: List&amp;lt;Adjunto&amp;gt;): Kudo&lt;br&gt;+ eventoPublicado(destinatario: Destinatario, correlationId: UUID): KudoPublicado&lt;/p&gt;" vertex="1">

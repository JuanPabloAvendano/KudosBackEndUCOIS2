        <mxCell id="leyenda" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Azul oscuro: persona · Azul: sistema propio · Gris: sistema externo&lt;br&gt;Continua: petición · Punteada: entrega o notificación" vertex="1">

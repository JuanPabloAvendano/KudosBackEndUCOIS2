        <mxCell id="e3" edge="1" parent="1" source="front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#ffffff;" target="entra" value="Inicia sesión&lt;br&gt;[OIDC + PKCE, HTTPS]">

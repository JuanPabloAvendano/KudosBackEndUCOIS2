        <mxCell id="miembro" parent="1" style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" value="&lt;b&gt;Miembro de la comunidad UCO&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Estudiante, docente o personal. Publica, lee y recibe Kudos. 90 % desde el celular." vertex="1">
          <mxGeometry height="200" width="220" x="60" y="140" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="html=1;fontSize=11;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona · rol de miembro]&lt;br&gt;&lt;br&gt;Miembro de la comunidad con rol administrador (rol de Entra que valida kudos-service). Publica y recibe Kudos como cualquiera y además consulta la auditoría." vertex="1">
          <mxGeometry height="240" width="240" x="50" y="540" as="geometry" />
        </mxCell>
        <mxCell id="kudos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;align=center;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;" value="&lt;b&gt;UCO Kudos&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;&lt;br&gt;Registra reconocimientos con adjuntos, los notifica por correo, WhatsApp y push en tiempo real, y audita cada paso. Front + kudos-service propios sobre servicios administrados de Azure (WAF en Front Door, correo con ACS Email)." vertex="1">
          <mxGeometry height="180" width="300" x="700" y="380" as="geometry" />
        </mxCell>
        <mxCell id="entra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;align=center;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" value="&lt;b&gt;Microsoft Entra External ID&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;&lt;br&gt;Proveedor de identidad: autentica a los usuarios y emite sus tokens." vertex="1">

        <mxCell id="1" parent="0" />
        <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18" value="&lt;b&gt;UCO Kudos · C4 nivel 2 · Contenedores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Borrador v13 · 9-nov-2026 · Juan Pablo Avendaño Duque · ADR-002, 003, 006, 007, 009 a 013, 015, 016 y 017 · infraestructura y SKU en la página Despliegue&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="900" x="230" y="-150" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10" value="&lt;b&gt;Leyenda&lt;/b&gt; · título = concepto · [tecnología · proveedor] · descripción = qué hace en el sistema&lt;br&gt;Azul oscuro: aplicación propia (código) · Azul claro: servicio administrado (solo configuración) · Gris: sistema externo&lt;br&gt;Continua: síncrono · Punteada: asíncrono / entrega · &lt;b&gt;1-8: Publicar Kudo · 9-10: recepción del destinatario&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="720" x="1190" y="-150" as="geometry" />
        </mxCell>
        <mxCell id="bound" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" value="&lt;b&gt;UCO Kudos&lt;/b&gt; [Sistema de software]" vertex="1">
          <mxGeometry height="967.5" width="1800" x="230" y="82.5" as="geometry" />
        </mxCell>
        <mxCell id="miembro" parent="1" style="html=1;fontSize=10;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" value="&lt;b&gt;Miembro de la comunidad UCO&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Publica, lee y recibe Kudos desde el celular." vertex="1">
          <mxGeometry height="180" width="200" x="-90" y="195" as="geometry" />
        </mxCell>
        <mxCell id="admin" parent="1" style="html=1;fontSize=10;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;[Persona · rol de miembro]&lt;br&gt;&lt;br&gt;Miembro con rol admin: además consulta la auditoría." vertex="1">
          <mxGeometry height="160" width="200" x="-90" y="420" as="geometry" />
        </mxCell>
        <mxCell id="entra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;[Microsoft Entra External ID]&lt;br&gt;&lt;br&gt;Autentica al usuario y emite el token con su rol." vertex="1">
          <mxGeometry height="95" width="200" x="790" y="-40" as="geometry" />
        </mxCell>
        <mxCell id="front" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;" value="&lt;b&gt;Front web&lt;/b&gt;&lt;br&gt;[SPA Vue 3 + TypeScript]&lt;br&gt;&lt;br&gt;Corre en el celular del miembro: publica, lee y recibe Kudos (ADR-002). Todas sus llamadas pasan por el WAF." vertex="1">
          <mxGeometry height="130" width="210" x="270" y="220" as="geometry" />
        </mxCell>
        <mxCell id="frontdoor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;[Azure Front Door + política WAF]&lt;br&gt;&lt;br&gt;Única entrada pública: reglas WAF personalizadas (tasa, IP, geo; sin OWASP), TLS; enruta /api/* al API Gateway con la cabecera X-Azure-FDID y entrega el front (CDN)." vertex="1">
          <mxGeometry height="140" width="250" x="620" y="155" as="geometry" />
        </mxCell>
        <mxCell id="apim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Azure API Management]&lt;br&gt;&lt;br&gt;validate-jwt (OIDC de Entra External ID), cuotas por usuario; enruta a kudos-service con la cabecera secreta (ADR-013). Rechaza lo que no trae la X-Azure-FDID de Front Door." vertex="1">
          <mxGeometry height="130" width="260" x="1000" y="155" as="geometry" />
        </mxCell>
        <mxCell id="pubsub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Real-time Push&lt;/b&gt;&lt;br&gt;[Azure Web PubSub]&lt;br&gt;&lt;br&gt;Entrega al instante el aviso del Kudo nuevo al destinatario conectado (Free: 20 conexiones)." vertex="1">
          <mxGeometry height="130" width="240" x="1370" y="155" as="geometry" />
        </mxCell>
        <mxCell id="kudos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#ffffff;" value="&lt;b&gt;Servicio de Kudos&lt;/b&gt;&lt;br&gt;[Java 21 · Spring Boot · contenedor]&lt;br&gt;&lt;br&gt;Núcleo de negocio (hexagonal): valida el JWT y la cabecera del gateway (ADR-013); guarda el Kudo con su outbox y lo audita, publica KudoPublicado con el relevo @Scheduled (ADR-010), sirve el feed con SAS de los adjuntos y la auditoría al admin, entrega la URL del Real-time Push." vertex="1">
          <mxGeometry height="190" width="260" x="940" y="380" as="geometry" />
        </mxCell>
        <mxCell id="keyvault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;[Azure Key Vault]&lt;br&gt;&lt;br&gt;Guarda secretos (Twilio, cabecera del gateway); kudos-service y el API Gateway los leen con su identidad (ADR-003, ADR-013)." vertex="1">
          <mxGeometry height="95" width="220" x="1450" y="505" as="geometry" />
        </mxCell>
        <mxCell id="appconfig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Parameter Catalog&lt;/b&gt;&lt;br&gt;[Azure App Configuration]&lt;br&gt;&lt;br&gt;Valores configurables sin tocar código: límites, plantillas, nombre del topic (ADR-003)." vertex="1">
          <mxGeometry height="95" width="220" x="470" y="505" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Caché&lt;/b&gt;&lt;br&gt;[Azure Managed Redis]&lt;br&gt;&lt;br&gt;Guarda el feed más leído para responder rápido (QA-1, ADR-017); se borra al publicar + TTL (ADR-011)." vertex="1">
          <mxGeometry height="90" width="240" x="1440" y="380" as="geometry" />
        </mxCell>
        <mxCell id="blob" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Blob Storage&lt;/b&gt;&lt;br&gt;[Azure Blob Storage · contenedor adjuntos]&lt;br&gt;&lt;br&gt;Guarda los adjuntos; el front los descarga con SAS de delegación de usuario (5-15 min)." vertex="1">
          <mxGeometry height="90" width="240" x="610" y="340" as="geometry" />
        </mxCell>
        <mxCell id="insights" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Observabilidad&lt;/b&gt;&lt;br&gt;[Application Insights + Log Analytics]&lt;br&gt;&lt;br&gt;Reúne trazas, métricas y logs con id de correlación de kudos-service, la Logic App y el diagnóstico de los demás recursos Azure (ver despliegue). Alertas y health." vertex="1">
          <mxGeometry height="160" width="260" x="350" y="670" as="geometry" />
        </mxCell>
        <mxCell id="postgres" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;[Azure Database for PostgreSQL]&lt;br&gt;&lt;br&gt;Fuente de verdad: Kudos, usuarios y outbox." vertex="1">
          <mxGeometry height="110" width="180" x="920" y="660" as="geometry" />
        </mxCell>
        <mxCell id="queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;[Azure Event Grid · topic kudos-eventos]&lt;br&gt;&lt;br&gt;Desacopla publicar de notificar: recibe KudoPublicado y lo empuja al instante a sus suscriptores; reintenta hasta 24 h; fallidos a Blob (mismo Storage)." vertex="1">
          <mxGeometry height="120" width="240" x="1350" y="650" as="geometry" />
        </mxCell>
        <mxCell id="datamesh" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Data Mesh · data product&lt;/b&gt;&lt;br&gt;[Azure Data Factory + Blob · catálogo JSON]&lt;br&gt;&lt;br&gt;Publica a diario los datos analíticos de Kudos como producto (esquema, dueño, frescura) en un catálogo en Blob (mismo Storage); solo lee, no toca el flujo en línea (ADR-015)." vertex="1">
          <mxGeometry height="130" width="260" x="620" y="845" as="geometry" />
        </mxCell>
        <mxCell id="table" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Auditoría&lt;/b&gt;&lt;br&gt;[Azure Table Storage]&lt;br&gt;&lt;br&gt;Solo-agregar: kudos-service registra Kudo guardado y evento publicado; la Logic App, cada notificación. Lo consulta el admin. Solo inserción y lectura (ADR-012)." vertex="1">
          <mxGeometry height="130" width="260" x="940" y="860" as="geometry" />
        </mxCell>
        <mxCell id="logic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Notification Gateway&lt;/b&gt;&lt;br&gt;[Azure Logic Apps]&lt;br&gt;&lt;br&gt;Recibe el evento, descarta duplicados por id (ADR-009) y avisa en paralelo por correo, WhatsApp y push, con reintentos; registra cada notificación en la auditoría." vertex="1">
          <mxGeometry height="130" width="240" x="1270" y="860" as="geometry" />
        </mxCell>
        <mxCell id="acs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;[Azure Communication Services Email]&lt;br&gt;&lt;br&gt;Envía el correo de aviso desde el dominio administrado por Azure." vertex="1">
          <mxGeometry height="100" width="220" x="1790" y="780" as="geometry" />
        </mxCell>
        <mxCell id="twilio" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;align=center;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" value="&lt;b&gt;Mensajería WhatsApp&lt;/b&gt;&lt;br&gt;[Twilio WhatsApp API]&lt;br&gt;&lt;br&gt;Entrega el aviso por WhatsApp." vertex="1">
          <mxGeometry height="100" width="200" x="2140" y="914" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="miembro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="front" value="Usa la web&lt;br&gt;[HTTPS]">

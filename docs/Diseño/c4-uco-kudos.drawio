        <mxCell id="e4" edge="1" parent="1" source="apim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;labelBackgroundColor=#ffffff;" target="entra" value="Valida el JWT [OIDC / JWKS, HTTPS]">
          <mxGeometry relative="1" x="-0.6756" as="geometry">

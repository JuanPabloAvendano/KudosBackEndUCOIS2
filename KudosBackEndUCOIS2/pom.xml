<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Stack aprobado por Juan el 9-nov-2026: lo más reciente estable (sin RC ni beta). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.uco</groupId>
    <artifactId>KudosBackEndUCOIS2</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>KudosBackEndUCOIS2</name>
    <description>Servicio de Kudos · UCO Kudos (IS2)</description>

    <properties>
        <java.version>27</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Sube lo que Boot 4.1.2 fija por debajo de lo último estable (solo menores y parches).
             Flyway se queda en la 12.x de Boot: la 13 es mayor y la autoconfiguración aún no la cubre. -->
        <hibernate.version>7.4.15.Final</hibernate.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <mockito.version>5.24.0</mockito.version>

        <!-- Transitivas con CVE reportadas por Mend.io (9-nov): a lo último estable -->
        <jackson-bom.version>3.3.0</jackson-bom.version>
        <logback.version>1.6.6</logback.version>
        <json-smart.version>2.6.1</json-smart.version>
        <asm.version>9.11.1</asm.version>
        <org-json.version>20260814</org-json.version>
        <!-- Jackson 3.3 exige annotations 2.23; el BOM de Jackson 2 de Boot fija 2.21 (NoClassDefFoundError JsonApplyView) -->
        <jackson-annotations.version>2.23</jackson-annotations.version>
        <!-- CVE-2026-110879 (9.8): Jackson 2 que trae azure-core; Boot 4.1.2 fija 2.21.7 -->
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <!-- CVE-2026-119078: Boot 4.1.2 trae 1.21.0 (solo pruebas, vía Testcontainers) -->
        <commons-codec.version>1.23.0</commons-codec.version>

        <!-- Azure SDK: el azure-sdk-bom va rezagado; estas cuatro se alinean en azure-core 1.61.0 -->
        <azure-identity.version>1.19.0</azure-identity.version>
        <azure-storage-blob.version>12.37.2</azure-storage-blob.version>
        <azure-data-tables.version>12.6.1</azure-data-tables.version>
        <azure-messaging-eventgrid.version>4.32.1</azure-messaging-eventgrid.version>

        <!-- Versiones que Spring Boot no administra -->
        <archunit.version>1.5.1</archunit.version>
        <jacoco.version>0.8.16</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!-- SonarQube Cloud (paso 2 · CI) -->
        <sonar.organization>juanpabloavendano</sonar.organization>
        <sonar.projectKey>JuanPabloAvendano_KudosBackEndUCOIS2</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson-annotations.version}</version>
            </dependency>
            <!-- Boot no administra ASM (llega por json-smart → accessors-smart) -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Seguridad: JWT de Entra External ID (resource server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistencia: JPA + Flyway + PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Caché del feed: Azure Managed Redis (ADR-017) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Azure: identidad administrada, adjuntos (Blob), auditoría (Table) y broker (Event Grid) -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure-identity.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>${azure-storage-blob.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-data-tables</artifactId>
            <version>${azure-data-tables.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-eventgrid</artifactId>
            <version>${azure-messaging-eventgrid.version}</version>
        </dependency>

        <!-- Salud y métricas (/actuator/health) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas: JUnit 6, AssertJ, Mockito (vienen con los starters de prueba).
             android-json (CVE sin parche, abandonado) se cambia por org.json, misma API para JSONassert. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${org-json.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Mockito como agente (Java 21+ avisa contra la carga dinámica); @{argLine} conserva el agente de JaCoCo -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar -Xshare:off</argLine>
                </configuration>
            </plugin>

            <!-- Cobertura para el quality gate de SonarQube Cloud -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
